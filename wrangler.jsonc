// Cloudflare Worker for gabrielprice.com: the built site from dist/ plus the owner's editor under /admin (worker/index.js).
// wrangler runs the build itself (build.command), so `npx wrangler deploy` works from GitHub Actions and from Cloudflare's
// Workers Builds alike. The name must match the Worker that Workers Builds is connected to.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gabrielprice-com",
  "build": { "command": "node scripts/build.mjs" },
  "main": "worker/index.js",
  // once a day: prune() in worker/flow.js deletes recorded visits older than 90 days
  "triggers": { "crons": ["17 4 * * *"] },
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  // the live domain; both need gabrielprice.com's nameservers moved to Cloudflare first
  "routes": [
    { "pattern": "gabrielprice.com", "custom_domain": true },
    { "pattern": "www.gabrielprice.com", "custom_domain": true }
  ],
  // every pull request gets a preview link at a workers.dev address; the editor stays locked there (no Access login)
  "workers_dev": true,
  "preview_urls": true,
  // visitor flow analytics (worker/flow.js). Create the bucket before deploying: DEPLOY.md, section 6.
  "r2_buckets": [
    { "binding": "FLOW", "bucket_name": "gabrielprice-flow" }
  ],
  "vars": {
    "GITHUB_REPO": "TOOPRICEYY/GabrielPrice.com"
  },
  // Workers Builds runs `wrangler preview` for PR branches. Preview bindings and variables
  // are explicit; assets and the compatibility date stay at the top level.
  "previews": {
    "vars": {
      "GITHUB_REPO": "TOOPRICEYY/GabrielPrice.com"
    },
    "r2_buckets": [
      { "binding": "FLOW", "bucket_name": "gabrielprice-flow-preview" }
    ]
  },
  // Secrets, set once in the Cloudflare dashboard (Workers → gabrielprice → Settings → Variables and Secrets) or with
  // `npx wrangler secret put NAME`. They are never in this repo:
  //   GITHUB_TOKEN        fine-grained token for this one repo: Contents, Issues and Pull requests read/write
  //   ALLOWED_EMAILS      who may edit, comma-separated
  //   ACCESS_TEAM_DOMAIN  e.g. https://yourteam.cloudflareaccess.com
  //   ACCESS_AUD          the Application Audience (AUD) tag of the Access application for gabrielprice.com/admin
  "observability": { "enabled": true }
}
